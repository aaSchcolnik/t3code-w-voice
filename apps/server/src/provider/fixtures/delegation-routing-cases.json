    {
      "name": "knowledge scan",
      "tasks": [
        {
          "laneId": "knowledge",
          "title": "Knowledge",
          "task": "Scan knowledge",
          "kind": "knowledge-scan",
          "role": "scout",
          "workspaceAccess": "read-only"
