{
  "defaults": {
    "providers": [
      {
        "id": "codex",
        "driver": "codex",
        "models": ["codex-general", "codex-special"],
        "capabilities": "full"
      },
      {
        "id": "cursor",
        "driver": "cursor",
        "models": ["cursor-general"],
        "capabilities": "interactive"
      },
      {
        "id": "claudeAgent",
        "driver": "claudeAgent",
        "models": ["claude-general"],
        "capabilities": "interactive"
      }
    ],
    "roles": {
      "scout": [
        { "provider": "cursor", "model": "cursor-general" },
        { "provider": "codex", "model": "codex-general" }
      ],
      "worker": [
        { "provider": "codex", "model": "codex-general" },
        { "provider": "cursor", "model": "cursor-general" }
      ]
    }
  },
  "cases": [
    {
      "name": "research uses hard read-only filtering",
      "tasks": [
        {
          "laneId": "research",
          "title": "Research",
          "task": "Inspect the subsystem",
          "kind": "research",
          "role": "scout",
          "workspaceAccess": "read-only"
        }
      ],
      "expected": {
        "selected": [{ "laneId": "research", "provider": "codex", "model": "codex-general" }],
        "policySource": "role_chain",
        "rejected": { "cursor": ["read_only_unenforced"] },
        "explanationIncludes": "role_chain"
      }
    },
    {
      "name": "planning kind is telemetry only",
      "tasks": [
        {
          "laneId": "planning",
          "title": "Plan",
          "task": "Draft a plan",
          "kind": "planning",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "selected": [{ "laneId": "planning", "provider": "codex", "model": "codex-general" }],
        "policySource": "role_chain",
        "taskKind": "planning",
        "explanationIncludes": "chain position 0"
      }
    },
    {
      "name": "implementation",
      "tasks": [
        {
          "laneId": "implementation",
          "title": "Implement",
          "task": "Make the change",
          "kind": "implementation",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "selected": [{ "laneId": "implementation", "provider": "codex" }],
        "policySource": "role_chain",
        "explanationIncludes": "Selected codex/codex"
      }
    },
    {
      "name": "debugging",
      "tasks": [
        {
          "laneId": "debugging",
          "title": "Debug",
          "task": "Find the defect",
          "kind": "debugging",
