      "expected": {
        "failure": "model_unavailable",
        "policySource": "explicit_constraint",
        "rejected": { "codex": ["model_unavailable"] },
        "explanationIncludes": "model_unavailable"
      }
    },
    {
      "name": "delegated child recursion is denied",
      "invokedByDelegatedChild": true,
      "tasks": [
        {
          "laneId": "recursive",
          "title": "Recursive",
          "task": "Do not recurse",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "failure": "recursion_forbidden",
        "policySource": "role_chain",
        "rejected": {
          "codex": ["recursion_forbidden"],
          "cursor": ["recursion_forbidden", "explicit_constraint_mismatch"]
        },
        "explanationIncludes": "recursion_forbidden"
      }
    },
    {
      "name": "trusted workflow override",
      "trustedContext": { "workflow": "plan" },
      "workflowOverrides": {
        "plan": { "worker": [{ "provider": "codex", "model": "codex-special" }] }
      },
      "tasks": [
        {
          "laneId": "workflow",
          "title": "Workflow",
          "task": "Use workflow policy",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "selected": [{ "laneId": "workflow", "provider": "codex", "model": "codex-special" }],
        "policySource": "workflow_override",
        "explanationIncludes": "workflow_override"
      }
    },
    {
      "name": "trusted skill override outranks workflow",
      "trustedContext": {
        "workflow": "plan",
        "skillOverride": {
          "worker": [{ "provider": "codex", "model": "codex-general" }]
        }
      },
      "workflowOverrides": {
        "plan": { "worker": [{ "provider": "codex", "model": "codex-special" }] }
      },
      "tasks": [
        {
          "laneId": "skill",
          "title": "Skill",
          "task": "Use skill policy",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "selected": [{ "laneId": "skill", "provider": "codex", "model": "codex-general" }],
        "policySource": "skill_override",
        "explanationIncludes": "skill_override"
      }
    },
    {
      "name": "batch diversity is deterministic in stable lane order",
      "providers": [
        {
          "id": "codex",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full"
        },
        {
          "id": "cursor",
          "driver": "cursor",
          "models": ["cursor-general"],
          "capabilities": "full"
        }
      ],
      "roles": {
        "worker": [
          { "provider": "codex", "model": "codex-general" },
          { "provider": "cursor", "model": "cursor-general" }
        ]
      },
      "tasks": [
        {
          "laneId": "lane-b",
          "title": "Second",
          "task": "Second input lane",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        },
        {
          "laneId": "lane-a",
          "title": "First",
          "task": "First stable lane",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "selected": [
          { "laneId": "lane-a", "provider": "codex" },
          { "laneId": "lane-b", "provider": "cursor" }
        ],
        "policySource": "role_chain",
        "explanationIncludes": "Selected"
      }
    }
