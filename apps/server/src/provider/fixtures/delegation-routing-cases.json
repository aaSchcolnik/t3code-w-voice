      ],
      "expected": {
        "selected": [{ "laneId": "single", "provider": "codex" }],
        "policySource": "role_chain",
        "explanationIncludes": "chain position 0"
      }
    },
    {
      "name": "multiple instances use stable resolver tie break",
      "providers": [
        {
          "id": "codex_zeta",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full"
        },
        {
          "id": "codex_alpha",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full"
        }
      ],
      "roles": { "worker": [{ "provider": "codex", "model": "codex-general" }] },
      "tasks": [
        {
          "laneId": "instances",
          "title": "Instances",
          "task": "Choose deterministically",
          "kind": "implementation",
          "role": "worker",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "selected": [
          {
            "laneId": "instances",
            "provider": "codex",
            "providerInstanceId": "codex_alpha"
          }
        ],
        "policySource": "role_chain",
        "explanationIncludes": "codex_alpha"
      }
    },
    {
      "name": "explicit provider model and options",
      "tasks": [
        {
          "laneId": "explicit",
          "title": "Explicit",
          "task": "Honor the explicit target",
          "kind": "implementation",
          "role": "worker",
          "workspaceAccess": "workspace-write",
          "providerConstraint": {
            "provider": "codex",
            "model": "codex-special",
            "options": [{ "id": "reasoningEffort", "value": "high" }]
          }
        }
      ],
      "expected": {
        "selected": [
          {
            "laneId": "explicit",
            "provider": "codex",
            "model": "codex-special",
            "options": [{ "id": "reasoningEffort", "value": "high" }]
          }
        ],
        "policySource": "explicit_constraint",
        "explanationIncludes": "explicit_constraint"
      }
    },
    {
      "name": "disabled explicit provider",
      "providers": [
        {
          "id": "codex",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full",
          "enabled": false
        }
      ],
      "tasks": [
        {
          "laneId": "disabled",
          "title": "Disabled",
          "task": "Cannot run",
          "role": "worker",
          "workspaceAccess": "workspace-write",
          "providerConstraint": { "provider": "codex" }
        }
      ],
      "expected": {
        "failure": "provider_disabled",
        "policySource": "explicit_constraint",
        "rejected": { "codex": ["provider_disabled"] },
        "explanationIncludes": "provider_disabled"
      }
    },
    {
      "name": "uninstalled explicit provider",
      "providers": [
        {
          "id": "codex",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full",
          "installed": false
        }
      ],
      "tasks": [
        {
          "laneId": "uninstalled",
          "title": "Uninstalled",
          "task": "Cannot run",
          "role": "worker",
          "workspaceAccess": "workspace-write",
