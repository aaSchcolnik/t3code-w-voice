      "expected": {
        "failure": "model_unavailable",
        "policySource": "explicit_constraint",
        "rejected": { "codex": ["model_unavailable"] },
        "explanationIncludes": "model_unavailable"
      }
    },
    {
      "name": "unknown explicit model option",
      "tasks": [
        {
          "laneId": "option",
          "title": "Unknown option",
          "task": "Cannot run",
          "role": "worker",
          "workspaceAccess": "workspace-write",
          "providerConstraint": {
            "provider": "codex",
            "model": "codex-general",
            "options": [{ "id": "missingOption", "value": true }]
