      "name": "unknown explicit model",
      "tasks": [
        {
          "laneId": "model",
          "title": "Unknown model",
          "task": "Cannot run",
          "role": "worker",
          "workspaceAccess": "workspace-write",
          "providerConstraint": { "provider": "codex", "model": "missing-model" }
