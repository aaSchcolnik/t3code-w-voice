    {
      "name": "ambiguous defaults to general worker without scoring",
      "tasks": [
        {
          "laneId": "ambiguous",
          "title": "Help",
          "task": "Handle this",
          "workspaceAccess": "workspace-write"
        }
      ],
      "expected": {
        "selected": [{ "laneId": "ambiguous", "provider": "codex" }],
        "policySource": "role_chain",
        "taskKind": "general",
        "explanationIncludes": "worker"
      }
    },
    {
      "name": "attachments are a hard capability",
      "providers": [
        {
          "id": "cursor",
          "driver": "cursor",
          "models": ["cursor-general"],
          "capabilities": "questions-only"
        },
        {
          "id": "codex",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full"
        }
      ],
      "roles": {
        "worker": [
          { "provider": "cursor", "model": "cursor-general" },
          { "provider": "codex", "model": "codex-general" }
        ]
      },
      "tasks": [
        {
          "laneId": "attachment",
          "title": "Inspect image",
          "task": "Inspect the attached screenshot",
          "kind": "review",
          "role": "worker",
          "workspaceAccess": "workspace-write",
          "attachments": [
            {
              "type": "image",
              "id": "image-1",
              "name": "screen.png",
              "mimeType": "image/png",
              "sizeBytes": 100
            }
          ]
        }
      ],
      "expected": {
        "selected": [{ "laneId": "attachment", "provider": "codex" }],
        "policySource": "role_chain",
        "rejected": { "cursor": ["missing_attachments", "explicit_constraint_mismatch"] },
        "explanationIncludes": "attachment"
      }
    },
    {
      "name": "structured questions are a hard capability",
      "providers": [
        {
          "id": "cursor",
          "driver": "cursor",
          "models": ["cursor-general"],
          "capabilities": "attachments-only"
        },
        {
          "id": "codex",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full"
        }
      ],
      "roles": {
        "worker": [
          { "provider": "cursor", "model": "cursor-general" },
          { "provider": "codex", "model": "codex-general" }
        ]
      },
      "tasks": [
        {
          "laneId": "questions",
          "title": "Interactive",
          "task": "Ask a structured question if blocked",
          "kind": "planning",
          "role": "worker",
          "workspaceAccess": "workspace-write",
          "interactionMode": "plan",
          "requiredCapabilities": { "structuredQuestions": true }
        }
      ],
      "expected": {
        "selected": [{ "laneId": "questions", "provider": "codex" }],
        "policySource": "role_chain",
        "rejected": { "cursor": ["missing_questions", "explicit_constraint_mismatch"] },
        "explanationIncludes": "questions"
      }
    },
    {
      "name": "read-only enforcement failure",
      "providers": [
        {
          "id": "cursor",
          "driver": "cursor",
          "models": ["cursor-general"],
          "capabilities": "interactive"
        }
      ],
      "roles": { "scout": [{ "provider": "cursor", "model": "cursor-general" }] },
      "tasks": [
        {
          "laneId": "read-only",
          "title": "Read",
          "task": "Read only",
          "kind": "research",
          "role": "scout",
          "workspaceAccess": "read-only"
        }
      ],
      "expected": {
        "failure": "read_only_unenforced",
        "policySource": "role_chain",
        "rejected": { "cursor": ["read_only_unenforced"] },
        "explanationIncludes": "read_only_unenforced"
      }
    },
    {
      "name": "one provider environment",
      "providers": [
        {
          "id": "codex",
          "driver": "codex",
          "models": ["codex-general"],
          "capabilities": "full"
        }
      ],
      "roles": { "worker": [{ "provider": "codex", "model": "codex-general" }] },
      "tasks": [
        {
          "laneId": "single",
          "title": "Single",
          "task": "Use the only provider",
          "kind": "implementation",
          "role": "worker",
          "workspaceAccess": "workspace-write"
